# Copia este archivo a .env.local y completa el valor real.
# .env.local no se versiona (ver .gitignore).

# API key de Resend (https://resend.com/api-keys), usada por
# app/api/contact/route.ts para enviar el correo del formulario de /about.
RESEND_API_KEY=

# URL y anon key del proyecto Supabase (Project Settings → API), usadas por
# lib/supabase/client.ts y lib/supabase/server.ts para conectar el SDK.
# Ver specs/04-supabase-client-integracion.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
